# TuCondoAquí — variables de entorno.
#
# Copia este archivo como `.env` y rellena los valores. El `.env` real NUNCA se
# sube al repositorio (está en .gitignore).
#
# IMPORTANTE: usa un proyecto de Firebase PROPIO, distinto del de cualquier otra
# app. Ver LEEME.md, sección "Firebase: un proyecto propio".

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary: fotos de los residentes y respaldos de las mantenciones.
# El preset "unsigned" debe permitir resource_type auto/raw para aceptar PDF.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# IA (opcional). Si no está, la app funciona igual: la sugerencia de categoría
# simplemente no aparece.
VITE_IA_API_KEY=
