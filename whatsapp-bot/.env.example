# Copia este archivo a ".env" (sin .example) y completa los valores reales.
# El archivo ".env" NUNCA se sube a git (ver .gitignore) porque tiene una contraseña real.

# --- Firebase: mismo proyecto que la app principal (app-incidencias-urbanas) ---
# Estos son los MISMOS valores que ya están en reporte-incidencias/.env, pero
# SIN el prefijo VITE_ (ese prefijo es solo para que Vite los exponga al navegador,
# este bot corre en Node puro y no lo necesita). Cópialos desde ahí.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Cuenta de funcionario dedicada exclusivamente a este bot ---
# Debe ser una cuenta creada en /dashboard/funcionarios con rol TERRENO
# (NO uses tu cuenta de Alcalde ni la compartas con una persona real: este bot
# inicia sesión con este correo/contraseña cada vez que arranca).
BOT_FUNCIONARIO_EMAIL=
BOT_FUNCIONARIO_PASSWORD=

# --- Link que se incluye en el mensaje de WhatsApp para que el vecino vea el detalle ---
# Déjalo así salvo que la URL de producción cambie.
PORTAL_URL_ESTADO=https://app-incidencias-urbanas.web.app/estado
