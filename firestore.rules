rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil del funcionario municipal que hizo login (null si no hay sesión).
    function perfilFuncionario() {
      return get(/databases/$(database)/documents/usuarios_municipales/$(request.auth.uid)).data;
    }

    function esFuncionarioAutenticado() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios_municipales/$(request.auth.uid));
    }

    // RBAC (3 roles): ALCALDE_ADMIN ve/gestiona todo el municipio (antes se
    // llamaba ADMIN); JEFE_DEPARTAMENTO está acotado a su propio departamento;
    // TERRENO no tiene función de rol propia acá (se acota por cuadrilla, a
    // nivel de UI, igual que antes de este cambio).
    function esAlcalde() {
      return esFuncionarioAutenticado() && perfilFuncionario().rol == 'ALCALDE_ADMIN';
    }

    // Multi-tenant: el funcionario solo puede operar sobre datos de SU PROPIA
    // municipalidad, sin importar su rol.
    function esDelMismoMunicipio(municipioId) {
      return esFuncionarioAutenticado() && perfilFuncionario().municipio_id == municipioId;
    }

    // Un Jefe de Departamento solo puede gestionar incidencias de SU propio
    // departamento (además de ser del mismo municipio); Alcalde y Terreno no
    // tienen esa restricción adicional.
    function puedeGestionarIncidencia(incidenciaData) {
      return esDelMismoMunicipio(incidenciaData.municipio_id) &&
        (perfilFuncionario().rol != 'JEFE_DEPARTAMENTO' ||
          perfilFuncionario().departamento == incidenciaData.departamento);
    }

    // Roster de trabajadores (Órdenes de Trabajo y Costeo, ver ESTADO_PROYECTO.md):
    // a diferencia de incidencias, acá SOLO el Jefe de Departamento de ESE
    // departamento puede escribir (ni el Alcalde ni otro Jefe) — es su propia
    // planilla de asistencia. El Alcalde igual puede leer (ver la tarjeta de
    // cualquier departamento desde el Dashboard General).
    function puedeGestionarTrabajador(trabajadorData) {
      return esDelMismoMunicipio(trabajadorData.municipio_id) &&
        perfilFuncionario().rol == 'JEFE_DEPARTAMENTO' &&
        perfilFuncionario().departamento == trabajadorData.departamento;
    }

    // Voto ciudadano ("+1", sin login): el update SOLO puede tocar upvotes y
    // usuarios_afectados, y ambos deben avanzar en exactamente 1 — así un voto
    // no puede además cambiar categoria/estado/cuadrilla/etc. Se usa .get(campo,
    // default) porque incidencias creadas antes de este cambio no tienen estos
    // campos todavía.
    function esVotoValidoIncidencia(antes, despues) {
      return request.auth == null &&
        despues.diff(antes).affectedKeys().hasOnly(['upvotes', 'usuarios_afectados']) &&
        despues.upvotes == antes.get('upvotes', 1) + 1 &&
        despues.usuarios_afectados.size() == antes.get('usuarios_afectados', []).size() + 1;
    }

    // Calificación ciudadana ("¿quedó bien resuelto?", 1-5 estrellas, sin login):
    // mismo espíritu que el voto — el update SOLO puede tocar calificacion_ciudadano,
    // solo si la incidencia ya está Resuelto, solo una vez (no se puede pisar una
    // calificación ya puesta), y el valor debe ser un entero entre 1 y 5.
    function esCalificacionValida(antes, despues) {
      return request.auth == null &&
        despues.diff(antes).affectedKeys().hasOnly(['calificacion_ciudadano']) &&
        antes.estado == 'Resuelto' &&
        antes.get('calificacion_ciudadano', null) == null &&
        despues.calificacion_ciudadano is int &&
        despues.calificacion_ciudadano >= 1 && despues.calificacion_ciudadano <= 5;
    }

    // --- Anti-spam de reportes ciudadanos (02-ago-2026) ---
    // La app ciudadana no tiene login, así que no hay usuario real que limitar.
    // Se usa el ID de dispositivo (utils/dispositivo.js: un UUID aleatorio en
    // localStorage, ya usado para los votos "+1") como identidad débil.
    //
    // Mecanismo: crear una incidencia SOLO se permite si en el MISMO lote
    // atómico (writeBatch, ver crearIncidencia) se está sellando
    // dispositivos/{id}.ultimo_reporte con la hora del servidor. getAfter() es
    // lo que hace esto obligatorio — sin él, bastaría con no escribir nunca la
    // marca para saltarse el límite. Además se exige que haya pasado el
    // enfriamiento desde el reporte anterior de ESE dispositivo.
    //
    // Límite conocido y aceptado: quien borre su localStorage (o use incógnito)
    // obtiene un ID nuevo y vuelve a cero — el mismo techo que ya tenía el
    // sistema de votos. Esto frena el spam accidental, el doble-envío y los
    // scripts ingenuos; NO a un atacante decidido. Para eso haría falta
    // Firebase App Check (ver §28 en ESTADO_PROYECTO.md).
    function rutaDispositivo(dispositivoId) {
      return /databases/$(database)/documents/dispositivos/$(dispositivoId);
    }

    function respetaEnfriamiento(dispositivoId) {
      return getAfter(rutaDispositivo(dispositivoId)).data.ultimo_reporte == request.time &&
        (!exists(rutaDispositivo(dispositivoId)) ||
          get(rutaDispositivo(dispositivoId)).data.ultimo_reporte < request.time - duration.value(60, 's'));
    }

    // Topes de tamaño: evitan que alguien infle la base de datos con textos
    // gigantes. Son holgados respecto de lo que permite el formulario.
    function textosDeTamanoRazonable(datos) {
      return datos.get('direccion_texto', '').size() <= 500 &&
        datos.get('detalles_adicionales', '').size() <= 2000 &&
        datos.get('nombre_ciudadano', '').size() <= 150 &&
        datos.get('contacto_ciudadano', '').size() <= 150 &&
        datos.get('rut_ciudadano', '').size() <= 20;
    }

    // dispositivos/{id}: solo guarda una marca de tiempo por dispositivo, nada
    // más. No se lista (evita enumerar dispositivos) y no se borra: borrarlo
    // sería justamente la forma de saltarse el enfriamiento.
    match /dispositivos/{dispositivoId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.auth == null &&
                              request.resource.data.keys().hasOnly(['ultimo_reporte']) &&
                              request.resource.data.ultimo_reporte == request.time;
      allow delete: if false;
    }

    // --- Municipalidades (tenants) ---
    // Catálogo público: la Vista Ciudadano (sin login) necesita leerlo para resolver
    // /:slug y aplicar el tema. Sin UI de creación todavía: se gestiona a mano desde
    // la consola de Firebase.
    match /municipalidades/{municipioId} {
      allow read: if true;
      allow write: if false;
    }

    // --- Incidencias ---
    // Cualquier ciudadano (sin login) puede CREAR un reporte para su municipalidad.
    // Solo funcionarios autenticados de ESA MISMA municipalidad pueden leer/actualizar/borrar.
    match /incidencias/{incidenciaId} {
      allow read: if esDelMismoMunicipio(resource.data.municipio_id);

      allow create: if request.resource.data.keys().hasAll(
                        ['categoria', 'coordenadas', 'estado', 'fecha_creacion', 'municipio_id']
                      ) &&
                      request.resource.data.estado == 'Pendiente' &&
                      request.resource.data.categoria is string &&
                      request.resource.data.municipio_id is string &&
                      request.resource.data.municipio_id.size() > 0 &&
                      exists(/databases/$(database)/documents/municipalidades/$(request.resource.data.municipio_id)) &&
                      request.resource.data.coordenadas.lat is number &&
                      request.resource.data.coordenadas.lng is number &&
                      // Triage automático: si el cliente manda nivel_gravedad, debe ser
                      // uno de los 3 valores válidos (evita que alguien mande basura ahí).
                      (!('nivel_gravedad' in request.resource.data) ||
                        request.resource.data.nivel_gravedad in ['Alta', 'Media', 'Baja']) &&
                      // Derivación automática por departamento: mismo criterio de
                      // validación que nivel_gravedad (ver utils/departamento.js).
                      (!('departamento' in request.resource.data) ||
                        request.resource.data.departamento in [
                          'Dirección de Obras (DOM)', 'Tránsito', 'Operaciones',
                          'Aseo y Ornato', 'Medio Ambiente', 'Seguridad Ciudadana',
                          'Oficina de Partes'
                        ]) &&
                      // Anti-spam (ver arriba): exige ID de dispositivo y que el
                      // mismo lote selle dispositivos/{id} respetando el enfriamiento.
                      textosDeTamanoRazonable(request.resource.data) &&
                      request.resource.data.dispositivo_id is string &&
                      request.resource.data.dispositivo_id.size() > 0 &&
                      respetaEnfriamiento(request.resource.data.dispositivo_id);

      allow update: if puedeGestionarIncidencia(resource.data) ||
                      esVotoValidoIncidencia(resource.data, request.resource.data) ||
                      esCalificacionValida(resource.data, request.resource.data);

      allow delete: if esAlcalde() && esDelMismoMunicipio(resource.data.municipio_id);
    }

    // Seguimientos: comentario/foto que el ciudadano agrega a un reporte YA
    // creado, sin login (ver ConsultaTicketPage.jsx) — mismo criterio de acceso
    // "a ciegas" que la calificación: el ciudadano conoce incidenciaId porque
    // tickets_publicos.{numero}.incidencia_id es público, pero no tiene permiso
    // de leer la incidencia ni esta subcolección (solo el funcionario del mismo
    // municipio puede leer, vía ListaSeguimientos.jsx en los paneles de gestión).
    match /incidencias/{incidenciaId}/seguimientos/{seguimientoId} {
      allow read: if esDelMismoMunicipio(
        get(/databases/$(database)/documents/incidencias/$(incidenciaId)).data.municipio_id
      );

      allow create: if request.auth == null &&
                      request.resource.data.keys().hasOnly(['texto', 'foto_url', 'autor', 'fecha']) &&
                      request.resource.data.autor == 'ciudadano' &&
                      request.resource.data.texto is string && request.resource.data.texto.size() <= 1000 &&
                      request.resource.data.foto_url is string &&
                      request.resource.data.fecha == request.time;

      allow update, delete: if false;
    }

    // --- Tickets públicos ---
    // Vista pública para que el ciudadano vea el estado de su reporte sin login,
    // Y alimenta el mapa tipo Waze (pines de reportes activos + chequeo de
    // proximidad) — por eso SOLO tiene campos no sensibles (nada de
    // nombre/contacto del ciudadano; sí lleva coordenadas y foto porque esas no
    // identifican a una persona, y son necesarias para el mapa).
    // El ID de documento es el numero_ticket: como Firestore clasifica un setDoc
    // sobre un doc ya existente como "update" (no "create") sin importar el método
    // usado en el cliente, y aquí no hay "allow update" para anónimos fuera del
    // voto (ver el allow update de abajo), un intento de crear un ticket con un número
    // ya usado por OTRO reporte es rechazado con permission-denied — ese rechazo
    // es el mecanismo real de unicidad (ver registrarTicketPublico en
    // ticketsPublicosService.js, que regenera el número y reintenta cuando pasa esto).
    match /tickets_publicos/{ticketId} {
      allow get: if true;
      // Antes era "if false" (evitar escanear todos los tickets) — ahora se
      // necesita listar para pintar el mapa ciudadano, y ya no hay nada sensible
      // que proteger en este documento.
      allow list: if true;

      allow create: if request.resource.data.keys().hasAll(
                        ['incidencia_id', 'municipio_id', 'categoria', 'estado', 'fecha_creacion']
                      ) &&
                      request.resource.data.estado == 'Pendiente' &&
                      request.resource.data.categoria is string &&
                      request.resource.data.municipio_id is string &&
                      request.resource.data.municipio_id.size() > 0 &&
                      exists(/databases/$(database)/documents/municipalidades/$(request.resource.data.municipio_id)) &&
                      (!('nivel_gravedad' in request.resource.data) ||
                        request.resource.data.nivel_gravedad in ['Alta', 'Media', 'Baja']) &&
                      (!('coordenadas' in request.resource.data) ||
                        (request.resource.data.coordenadas.lat is number &&
                          request.resource.data.coordenadas.lng is number));

      // El funcionario del mismo municipio refleja cambios de estado (asignar
      // cuadrilla / marcar resuelto); cualquier ciudadano (sin login) puede votar
      // "+1" (solo upvotes, +1 exacto) o reflejar su calificación ya puesta en
      // incidencias/{id} (solo una vez, mismo criterio que esCalificacionValida).
      allow update: if esDelMismoMunicipio(resource.data.municipio_id) ||
                      (request.auth == null &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes']) &&
                        request.resource.data.upvotes == resource.data.get('upvotes', 1) + 1) ||
                      (request.auth == null &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['calificacion_ciudadano']) &&
                        resource.data.get('calificacion_ciudadano', null) == null &&
                        request.resource.data.calificacion_ciudadano is int &&
                        request.resource.data.calificacion_ciudadano >= 1 && request.resource.data.calificacion_ciudadano <= 5);

      allow delete: if false;
    }

    // --- Usuarios municipales ---
    // Nadie puede crearse a sí mismo un perfil con rol (evita que un ciudadano se
    // autoasigne un rol). Los perfiles los crea un Alcalde existente (de la MISMA
    // municipalidad) o se cargan manualmente desde la consola de Firebase.
    match /usuarios_municipales/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if esAlcalde() && esDelMismoMunicipio(resource.data.municipio_id);

      // En "create" el documento todavía no existe, así que no hay "resource.data":
      // se valida contra el municipio del propio Alcalde que está creando el perfil.
      // No se permite crear otro ALCALDE_ADMIN desde esta vía (solo JEFE_DEPARTAMENTO
      // o TERRENO) — evita que la UI de autogestión sirva para autoescalar privilegios;
      // crear otro Alcalde sigue siendo una acción manual desde la consola.
      allow create: if esAlcalde()
                      && request.resource.data.municipio_id == perfilFuncionario().municipio_id
                      && request.resource.data.rol in ['JEFE_DEPARTAMENTO', 'TERRENO'];

      allow update, delete: if esAlcalde() && esDelMismoMunicipio(resource.data.municipio_id);
    }

    // --- Trabajadores (roster de asistencia por departamento) ---
    // Sin cuenta de acceso propia (a diferencia de usuarios_municipales) — es
    // una lista simple que administra el Jefe de Departamento, similar a como
    // "cuadrillas" es hoy un array de strings en municipalidades/{slug}.
    match /trabajadores/{trabajadorId} {
      allow read: if esDelMismoMunicipio(resource.data.municipio_id);

      allow create: if esFuncionarioAutenticado()
                      && request.resource.data.municipio_id == perfilFuncionario().municipio_id
                      && perfilFuncionario().rol == 'JEFE_DEPARTAMENTO'
                      && perfilFuncionario().departamento == request.resource.data.departamento;

      allow update, delete: if puedeGestionarTrabajador(resource.data);
    }

    // --- Ubicación manual de cuadrillas ---
    // "Ubicación en tiempo real" pedida por el usuario, pero manual (ver §17):
    // el Jefe de Departamento marca a mano dónde está trabajando una cuadrilla
    // ahora mismo (no hay GPS real — los trabajadores no tienen cuenta ni
    // dispositivo propio). Cualquier funcionario del municipio puede leer (así
    // el Alcalde ve el link "Ver ubicación exacta" desde el Dashboard General).
    match /ubicaciones_cuadrilla/{ubicacionId} {
      allow read: if esDelMismoMunicipio(resource.data.municipio_id);
      allow write: if esFuncionarioAutenticado()
                      && request.resource.data.municipio_id == perfilFuncionario().municipio_id
                      && perfilFuncionario().rol == 'JEFE_DEPARTAMENTO';
    }
  }
}
