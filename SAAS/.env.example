# Copiar a .env y rellenar. .env NO se versiona.

# --- ChileCompra -------------------------------------------------------
# Ticket gratuito: formulario "Solicitud de Ticket" en api.mercadopublico.cl.
# Llega por correo. Cuota: 10.000 peticiones al día.
CHILECOMPRA_TICKET=

# --- Supabase ----------------------------------------------------------
# Ambas salen de Project Settings -> API en el panel de Supabase.
SUPABASE_URL=
# Esta clave SALTA RLS. Es equivalente a la contraseña de la base:
# solo en el backend, nunca en una variable NEXT_PUBLIC_*, nunca en un log.
SUPABASE_SERVICE_ROLE_KEY=

# Estas dos SÍ viajan al navegador, y está bien: lo que protege los datos
# son las políticas de RLS, no el secreto de la clave anon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cron --------------------------------------------------------------
# Secreto compartido que protege /api/cron/*. Sin esto, cualquiera dispara
# la ingesta y quema la cuota diaria de la API.
CRON_SECRET=
