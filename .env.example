# Copiar este archivo como ".env" y completar con los valores reales
# de la consola de Firebase (Configuración del proyecto > Tus apps > SDK setup and configuration).
# NUNCA subir el archivo ".env" real a un repositorio público.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" para desarrollar contra el Firebase Emulator Suite local (npm run emulators)
# en vez de un proyecto real. Ver README de emuladores.
VITE_USE_FIREBASE_EMULATORS=false

# Subida de fotos de incidencias (Cloudinary, plan gratis sin tarjeta — ver
# ESTADO_PROYECTO.md). Cloud name aparece en el Dashboard de Cloudinary; el
# upload preset se crea en Settings > Upload > Upload presets, con
# "Signing Mode: Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Buscador de direcciones del Paso 1 (services/geocodificacionService.js).
# Clave de Google Cloud Console con la Geocoding API habilitada y facturación
# activa, restringida por HTTP referrer al dominio de producción y a
# localhost. Ver ESTADO_PROYECTO.md.
VITE_GOOGLE_MAPS_API_KEY=
